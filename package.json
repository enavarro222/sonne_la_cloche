{
  "name": "sonne-la-cloche",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:coverage": "E2E_COVERAGE=1 playwright test",
    "og-image": "node --experimental-strip-types --no-warnings scripts/og-image.ts",
    "test:server": "python3 -m unittest discover -s server -q",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:server && pnpm e2e",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@markw65/fit-file-writer": "^0.2.0",
    "i18next": "^26.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fit-file-parser": "^6.1.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "monocart-coverage-reports": "^2.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
